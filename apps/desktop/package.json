{
  "name": "@nexus/desktop",
  "productName": "Nexus",
  "version": "0.0.1",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "rebuild:native": "electron-rebuild -f -w node-pty"
  },
  "dependencies": {
    "@nexus/core": "workspace:*",
    "@nexus/shared": "workspace:*",
    "@nexus/tools": "workspace:*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "naive-ui": "^2.45.3",
    "node-pty": "^1.1.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "electron": "^45.3.3",
    "electron-vite": "^6.0.0",
    "less": "^4.9.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  },
  "build": {
    "extraResources": [
      {
        "from": "resources/plugins",
        "to": "plugins"
      }
    ]
  }
}
