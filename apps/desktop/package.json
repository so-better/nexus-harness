{
  "name": "@nexus/desktop",
  "productName": "Nexus",
  "version": "0.0.1",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "pnpm run typecheck:node && pnpm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
    "typecheck:web": "vue-tsc --noEmit -p tsconfig.web.json --composite false",
    "rebuild:native": "electron-rebuild -f -w node-pty",
    "dist:mac": "pnpm build && electron-builder --mac",
    "dist:mac:arm64": "pnpm build && electron-builder --mac --arm64",
    "dist:mac:x64": "pnpm build && electron-builder --mac --x64",
    "dist:win": "pnpm build && electron-builder --win",
    "dist:win:x64": "pnpm build && electron-builder --win --x64",
    "dist": "pnpm build && electron-builder"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@napi-rs/canvas": "0.1.80",
    "@nexus/core": "workspace:*",
    "@nexus/runtime-utils": "workspace:*",
    "@nexus/shared": "workspace:*",
    "@nexus/toolkit": "workspace:*",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "adm-zip": "^0.6.1",
    "dompurify": "^3.4.18",
    "echarts": "^6.1.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.1",
    "marked": "^18.2.1",
    "mermaid": "^12.3.0",
    "monaco-editor": "^0.57.0",
    "naive-ui": "^2.45.3",
    "node-pty": "^1.1.0",
    "pinia": "^4.1.0",
    "semver": "^7.8.6",
    "vue": "^3.5.45",
    "vue-draggable-plus": "^0.6.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/adm-zip": "^0.6.0",
    "@types/node": "^26.6.6",
    "@types/semver": "^7.8.0",
    "@vitejs/plugin-vue": "^6.0.11",
    "electron": "^45.3.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "jsdom": "^31.0.1",
    "less": "^4.9.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vue-tsc": "^3.3.14"
  },
  "build": {
    "asarUnpack": [
      "node_modules/@napi-rs/**",
      "**/*.node"
    ],
    "extraResources": [
      {
        "from": "resources/plugins",
        "to": "plugins"
      },
      {
        "from": "resources/mcp",
        "to": "mcp"
      },
      {
        "from": "resources/skills",
        "to": "skills"
      },
      {
        "from": "out/assets/fonts",
        "to": "fonts"
      },
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      }
    ],
    "icon": "build/icon",
    "appId": "com.nexus.harness",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "description": "Nexus AI Agent desktop workspace",
  "author": "Nexus",
  "packageManager": "pnpm@10.27.0"
}
