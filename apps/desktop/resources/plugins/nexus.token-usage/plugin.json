{
  "id": "nexus.token-usage",
  "name": "Token 用量",
  "version": "1.20.0",
  "description": "在会话标题栏和每条 AI 消息尾部显示 token 用量；消息尾部同时显示提供商 / 模型；耗时与字数可在插件设置中开启（默认关闭）；提供会话/全局用量看板，以及左侧导航栏「用量统计」整页：可按今天/本周/本月/今年/自定义日期范围与指定会话查看用量，含环比、token 构成与调用次数同图的趋势、缓存效率与排行，所有数值均标注单位。",
  "engines": {
    "nexus": ">=0.0.1 <0.1.0"
  },
  "renderer": "dist/renderer.mjs",
  "shadowDom": false,
  "activationEvents": ["onSlot:usage.inline", "onSlot:usage.session", "onView:usage.dashboard", "onView:usage.stats"],
  "permissions": [
    "ui.slot",
    "ui.panel",
    "usage:read",
    "events:usage.recorded",
    "events:session.removed"
  ],
  "contributes": {
    "messageSlots": [
      {
        "id": "usage.inline",
        "location": "message.assistant.footer"
      },
      {
        "id": "usage.session",
        "location": "session.header.actions"
      }
    ],
    "views": [
      {
        "id": "usage.dashboard",
        "title": "Token 用量"
      },
      {
        "id": "usage.stats",
        "title": "用量统计"
      }
    ],
    "navigation": [
      {
        "id": "usage.stats",
        "title": "用量统计",
        "viewId": "usage.stats",
        "iconAsset": "assets/icon.svg"
      }
    ],
    "settings": [
      {
        "key": "showDuration",
        "type": "boolean",
        "default": false,
        "title": "显示耗时"
      },
      {
        "key": "showChars",
        "type": "boolean",
        "default": false,
        "title": "显示字数"
      }
    ]
  }
}
