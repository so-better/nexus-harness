{
  "id": "nexus.token-usage",
  "name": "Token 用量",
  "version": "1.13.0",
  "description": "在会话标题栏和每条 AI 消息尾部显示 token 用量；耗时与字数可在插件设置中开启（默认关闭）；提供会话/全局用量看板、缓存命中率、当前会话上下文窗口占用与构成。",
  "engines": {
    "nexus": ">=0.0.1 <0.1.0"
  },
  "renderer": "dist/renderer.mjs",
  "activationEvents": ["onSlot:usage.inline", "onSlot:usage.session", "onView:usage.dashboard"],
  "permissions": [
    "ui.slot",
    "ui.panel",
    "usage:read",
    "events:usage.recorded",
    "events:session.removed"
  ],
  "contributes": {
    "messageSlots": [
      {
        "id": "usage.inline",
        "location": "message.assistant.footer"
      },
      {
        "id": "usage.session",
        "location": "session.header.actions"
      }
    ],
    "views": [
      {
        "id": "usage.dashboard",
        "title": "Token 用量"
      }
    ],
    "settings": [
      {
        "key": "showDuration",
        "type": "boolean",
        "default": false,
        "title": "显示耗时"
      },
      {
        "key": "showChars",
        "type": "boolean",
        "default": false,
        "title": "显示字数"
      }
    ]
  }
}
