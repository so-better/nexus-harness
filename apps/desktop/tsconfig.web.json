{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/renderer/*"],
      "@shared/*": ["../../packages/shared/src/*"]
    },
    "composite": true
  },
  "include": [
    "src/renderer/**/*.ts",
    "src/renderer/**/*.vue",
    "src/renderer/**/*.d.ts",
    "../../packages/shared/src/**/*.ts"
  ],
  "exclude": ["../../packages/core/src/**/*.test.ts", "../../packages/shared/src/**/*.test.ts"]
}
