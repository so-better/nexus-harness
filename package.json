{
  "name": "nexus-harness",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.27.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --filter @nexus/desktop dev",
    "build": "pnpm --filter @nexus/desktop build",
    "gen:shims": "pnpm --filter @nexus/desktop gen:shims",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "lint:style": "stylelint \"apps/**/*.{vue,less,css}\" \"packages/**/*.{less,css}\"",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "rebuild:native": "pnpm --filter @nexus/desktop rebuild:native",
    "postinstall": "pnpm --filter @nexus/desktop rebuild:native",
    "dist:mac": "pnpm --filter @nexus/desktop dist:mac",
    "dist:win": "pnpm --filter @nexus/desktop dist:win",
    "dist": "pnpm --filter @nexus/desktop dist",
    "test:e2e:app": "pnpm build && node apps/desktop/e2e/full-smoke.mjs",
    "test:e2e": "pnpm test:e2e:app"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild",
      "node-pty"
    ],
    "peerDependencyRules": {
      "allowedVersions": {
        "@napi-rs/canvas": "0.1.80"
      }
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-vue": "^6.0.11",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "playwright-core": "^1.65.1",
    "postcss-html": "^2.0.1",
    "postcss-less": "^7.1.1",
    "prettier": "^3.10.1",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}
